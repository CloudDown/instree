# Instree Web — service systemd (LAN)
# 1. Copier vers /etc/systemd/system/instree-web.service
# 2. Adapter User, WorkingDirectory, INSTREE_HOME
# 3. sudo systemctl enable --now instree-web
#
# Avec ngrok au boot : voir deploy/pi/setup-remote.sh (recommandé Pi)

[Unit]
Description=Instree Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/instree
Environment=INSTREE_HOME=/var/lib/instree
Environment=INSTREE_WEB=1
Environment=PATH=/home/pi/instree/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pi/instree/.venv/bin/instree-web --ngrok --host 0.0.0.0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
