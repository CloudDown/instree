#!/usr/bin/env bash
# Instree Web — serveur multi-utilisateurs (auth, données isolées)
# Usage :
#   ./bin/run-web              # ngrok (HTTPS public, défaut)
#   ./bin/run-web --no-ngrok   # LAN seulement
#   ./bin/run-web --lan        # alias de --no-ngrok
# Données : var/web/  (hors git ; ou INSTREE_HOME en prod)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

echo
echo "  Instree Web"
echo "  -----------"
echo

if [[ ! -f var/desktop/config/instree.toml && ! -f config/instree.toml && ! -f pyproject.toml ]]; then
  echo "[ERREUR] Lance depuis la racine du projet Instree."
  exit 1
fi

if [[ ! -x .venv/bin/instree-web ]]; then
  echo "[..] Environnement manquant — installation via Desktop…"
  "$ROOT/bin/run-desktop" --help >/dev/null 2>&1 || true
fi

if [[ ! -x .venv/bin/instree-web ]]; then
  export PATH="${HOME}/.local/bin:${HOME}/.cargo/bin:${PATH}"
  if command -v uv >/dev/null 2>&1; then
    uv sync
  else
    python3 -m venv .venv
    .venv/bin/pip install -q --upgrade pip
    .venv/bin/pip install -q -e .
  fi
fi

if [[ ! -x .venv/bin/instree-web ]]; then
  echo "[ERREUR] instree-web introuvable. Lance d'abord ./bin/run-desktop."
  exit 1
fi

DATA="${INSTREE_HOME:-$ROOT/var/web}"
echo "[OK] Instree Web — données dans $DATA (hors git)"

USE_NGROK=1
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --no-ngrok|--lan) USE_NGROK=0 ;;
    *) ARGS+=("$arg") ;;
  esac
done

if [[ $USE_NGROK -eq 1 ]]; then
  exec .venv/bin/instree-web --ngrok "${ARGS[@]}"
fi
exec .venv/bin/instree-web "${ARGS[@]}"
