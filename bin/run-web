#!/usr/bin/env bash
# Instree Web — serveur multi-utilisateurs (auth, données isolées)
# Usage :
#   ./bin/run-web           # LAN
#   ./bin/run-web --ngrok   # tunnel HTTPS temporaire
# Données : var/web/  (ou serveur/ legacy, ou INSTREE_HOME)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

echo
echo "  Instree Web"
echo "  -----------"
echo

if [[ ! -f config/instree.toml && ! -f var/desktop/config/instree.toml && ! -f pyproject.toml ]]; then
  echo "[ERREUR] Lance depuis la racine du projet Instree."
  exit 1
fi

if [[ ! -x .venv/bin/instree-web ]]; then
  echo "[..] Environnement manquant — installation via Desktop…"
  "$ROOT/bin/run-desktop" --help >/dev/null 2>&1 || true
fi

if [[ ! -x .venv/bin/instree-web ]]; then
  export PATH="${HOME}/.local/bin:${HOME}/.cargo/bin:${PATH}"
  if command -v uv >/dev/null 2>&1; then
    uv sync
  else
    python3 -m venv .venv
    .venv/bin/pip install -q --upgrade pip
    .venv/bin/pip install -q -e .
  fi
fi

if [[ ! -x .venv/bin/instree-web ]]; then
  echo "[ERREUR] instree-web introuvable. Lance d'abord ./run."
  exit 1
fi

# Prefer new path; legacy serveur/ still works via default_web_home()
if [[ -d "$ROOT/var/web" ]]; then
  DATA="${INSTREE_HOME:-$ROOT/var/web}"
elif [[ -d "$ROOT/serveur" ]]; then
  DATA="${INSTREE_HOME:-$ROOT/serveur}"
else
  DATA="${INSTREE_HOME:-$ROOT/var/web}"
fi
echo "[OK] Instree Web — données dans $DATA"
exec .venv/bin/instree-web "$@"
